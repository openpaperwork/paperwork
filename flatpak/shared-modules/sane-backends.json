{
    "name": "sane-backends",
    "buildsystem": "autotools",
    "config-opts": [
        "--disable-saned"
    ],
    "build-options": {
        "cflags": "-std=gnu18"
    },
    "sources": [
        {
            "type": "archive",
            "url": "https://gitlab.com/-/project/429008/uploads/843c156420e211859e974f78f64c3ea3/sane-backends-1.4.0.tar.gz",
            "sha256": "f99205c903dfe2fb8990f0c531232c9a00ec9c2c66ac7cb0ce50b4af9f407a72"
        }
    ],
    "post-install": [
        "rm /app/etc/sane.d/dll.conf",
        "rm /app/etc/sane.d/net.conf",
        "echo 127.0.0.1 > /app/etc/sane.d/net.conf",
        "echo net > /app/etc/sane.d/dll.conf"
    ]
}
